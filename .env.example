# Copy to .env (local) or set in your hosting dashboard.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: turns on Claude AI writing for plans, documents and the assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 when the site is served over HTTPS (production)
HTTPS_ONLY=0
# Optional: public address used in share links, e.g. https://missionpilot.onrender.com
PUBLIC_URL=
# Optional: real-time e-mails through Gmail (use a Gmail App password, see README)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# Optional: protects /api/cron/daily and /api/cron/weekly
CRON_SECRET=
